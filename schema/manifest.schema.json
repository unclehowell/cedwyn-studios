{
 "$id": "cedwyn-studios/manifest@1",
 "type": "object",
 "required": [
  "schema",
  "scene",
  "store",
  "objects",
  "renders"
 ],
 "properties": {
  "schema": {
   "enum": [
    "cedwyn-studios/manifest@1"
   ]
  },
  "objects": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "sha256",
     "bytes"
    ],
    "properties": {
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "bytes": {
      "type": "integer"
     }
    }
   }
  },
  "renders": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "shot",
     "unit",
     "step",
     "output_key"
    ]
   }
  }
 }
}
