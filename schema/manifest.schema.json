{
 "$id": "cedwyn-studios/manifest@1",
 "type": "object",
 "required": [
  "schema",
  "scene",
  "store",
  "objects",
  "renders"
 ],
 "properties": {
  "schema": {
   "enum": [
    "cedwyn-studios/manifest@1"
   ]
  },
  "objects": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "sha256",
     "bytes"
    ],
    "properties": {
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "bytes": {
      "type": "integer"
     },
     "content_type": {
      "type": "string"
     },
     "release": {
      "type": "string",
      "pattern": "^media-(F[0-9]{3}|shared)$"
     },
     "asset": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
     },
     "github": {
      "type": "string",
      "pattern": "^https://github\\.com/unclehowell/cedwyn-studios/releases/download/media-(F[0-9]{3}|shared)/[A-Za-z0-9._-]+$"
     },
     "cid": {
      "type": "string",
      "pattern": "^baf[a-z2-7]{50,}$"
     },
     "release_state": {
      "enum": [
       "verified",
       "uploaded",
       "pending"
      ]
     },
     "mirrors": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "renders": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "shot",
     "unit",
     "step",
     "output_key"
    ]
   }
  },
  "store": {
   "enum": [
    "github-releases",
    "r2:cedwyn-studios"
   ]
  },
  "mirror": {
   "type": "string"
  }
 },
 "description": "Scene media manifest. Media lives in GitHub Releases (release media-<scene>, asset URL in github); R2 is an optional mirror. Each object: sha256, bytes, IPFS CIDv1 (cid). See STUDIO.md section 3."
}
